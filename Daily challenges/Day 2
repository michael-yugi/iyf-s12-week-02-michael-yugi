/* Daily Challenge Card */
.daily-card {
    max-width: 350px;
    overflow: hidden;
    background-color: white;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.daily-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
}

.daily-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
}

.daily-card-content {
    padding: 20px;
}

.daily-card-content h3 {
    margin-top: 0;
}

.card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0;
}

.card-tags span {
    background-color: #dbeafe;
    color: #1d4ed8;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 13px;
}

.card-button {
    display: inline-block;
    background-color: #2563eb;
    color: white;
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
}

.card-button:hover {
    background-color: #1d4ed8;
}