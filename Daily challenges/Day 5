/* Responsive Footer */
.daily-footer {
    background-color: #1e293b;
    color: white;
    padding: 40px 20px 15px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
}

.footer-item h3 {
    color: #60a5fa;
}

.footer-item a {
    display: block;
    color: white;
    text-decoration: none;
    margin-bottom: 10px;
}

.footer-item a:hover {
    color: #60a5fa;
}

.footer-bottom {
    text-align: center;
    border-top: 1px solid #475569;
    margin-top: 30px;
    padding-top: 15px;
}

/* Tablet: Two columns */
@media (min-width: 768px) {
    .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* Desktop: Four columns */
@media (min-width: 1024px) {
    .footer-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}